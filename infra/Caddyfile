# TLS + reverse proxy. Two hostnames:
#   chouf.tn          → web app. Behind the Cloudflare proxy (orange cloud); the origin only answers
#                       Cloudflare, so the CF-IPCountry header used for geo-blocking cannot be forged.
#   live-origin.chouf.tn → live gateway. DNS-only (grey cloud): video may not go through the Cloudflare
#                       proxy. Put Bunny CDN in front (pull zone origin = this host) and point
#                       LIVE_BASE_URL at the Bunny hostname; or use this host directly at small scale.
# Keep the Cloudflare ranges in sync with https://www.cloudflare.com/ips/
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	@notCloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @notCloudflare 403

	encode zstd gzip
	reverse_proxy web:3000
}

live-origin.{$APP_DOMAIN} {
	# Playlists are tiny and per-viewer; segments are already compressed video: no encode.
	reverse_proxy gateway:8788 {
		flush_interval -1
	}
}
