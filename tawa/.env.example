# Postgres (Render fournit DATABASE_URL automatiquement via render.yaml)
DATABASE_URL=postgres://tawa:tawa@localhost:5432/tawa

# Secret de signature des cookies de session (chaîne aléatoire longue)
SESSION_SECRET=change-me

# Mot de passe du back-office /admin
ADMIN_PASSWORD=change-me

# Optionnel : active la compréhension des adresses en derja par Claude.
# Sans clé, l'app utilise le dictionnaire de lieux intégré + OpenStreetMap.
ANTHROPIC_API_KEY=

# Serveur d'itinéraires OSRM. Par défaut, le serveur de démonstration public
# (usage limité). En production : un OSRM auto-hébergé avec la carte de Tunisie.
OSRM_URL=https://router.project-osrm.org

# Géocodage OpenStreetMap (Nominatim). En production : instance dédiée.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Mode démo : chauffeurs simulés qui acceptent et se déplacent tout seuls.
DEMO_MODE=true
