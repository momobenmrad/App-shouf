# ── Chouf configuration ─────────────────────────────────────────────────────────────
# Copy to .env (docker compose) and apps/web/.env.local (pnpm dev). Never commit real values.

APP_DOMAIN=chouf.tn
APP_URL=http://localhost:3000

# Supabase (Dashboard → Project Settings → API, or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=

# Signed playback URLs — same value in the web app and the edge (wrangler secret put SIGNING_SECRET).
# Generate with: openssl rand -base64 48
PLAYBACK_SIGNING_SECRET=dev-only-signing-secret-change-me-0123456789
# Public base URL of the edge (Cloudflare Worker in prod, http://localhost:8787 in dev)
VOD_BASE_URL=http://localhost:8787

REDIS_URL=redis://localhost:6379

# Object storage — Cloudflare R2 in prod (https://<account>.r2.cloudflarestorage.com), SeaweedFS in dev (docker-compose.dev.yml)
S3_ENDPOINT=http://localhost:9000
# Endpoint reachable by the admin's browser for direct uploads (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=chouf-media
S3_ACCESS_KEY_ID=chouf
S3_SECRET_ACCESS_KEY=chouf-dev-secret

# Konnect (https://dashboard.konnect.network) — sandbox by default
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# Local dev only: country used when no CF-IPCountry header is present
DEFAULT_COUNTRY=TN
FREE_MAX_STREAMS=1

# Worker
TRANSCODE_CONCURRENCY=1
TRANSCODE_PRESET=veryfast
# Slack/Discord/Telegram-bridge compatible webhook for alerts (optional)
ALERT_WEBHOOK_URL=
